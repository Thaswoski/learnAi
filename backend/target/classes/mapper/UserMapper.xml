<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.griya.learn.mapper.UserMapper">

    <resultMap id="userMap" type="com.griya.learn.entity.User">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="email" column="email"/>
        <result property="password" column="password"/>
        <result property="role" column="role"/>
        <result property="avatar" column="avatar"/>
        <result property="token" column="token"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="selectById" resultMap="userMap">
        SELECT id, name, email, password, role, avatar, token, created_at, updated_at
        FROM `user`
        WHERE id = #{id}
    </select>

    <select id="selectByEmail" resultMap="userMap">
        SELECT id, name, email, password, role, avatar, token, created_at, updated_at
        FROM `user`
        WHERE email = #{email}
    </select>

    <select id="selectByToken" resultMap="userMap">
        SELECT id, name, email, password, role, avatar, token, created_at, updated_at
        FROM `user`
        WHERE token = #{token}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `user` (name, email, password, role, avatar, token)
        VALUES (#{name}, #{email}, #{password}, #{role}, #{avatar}, #{token})
    </insert>

    <update id="updateToken">
        UPDATE `user` SET token = #{token} WHERE id = #{id}
    </update>

    <update id="updateById">
        UPDATE `user`
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="email != null">email = #{email},</if>
            <if test="avatar != null">avatar = #{avatar},</if>
        </set>
        WHERE id = #{id}
    </update>

    <update id="updatePassword">
        UPDATE `user` SET password = #{password} WHERE id = #{id}
    </update>

</mapper>
