<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.griya.learn.community.mapper.CommentMapper">

    <resultMap id="commentMap" type="com.griya.learn.community.entity.Comment">
        <id property="id" column="id"/>
        <result property="postId" column="post_id"/>
        <result property="heritageId" column="heritage_id"/>
        <result property="parentId" column="parent_id"/>
        <result property="authorId" column="author_id"/>
        <result property="authorName" column="author_name"/>
        <result property="toUserId" column="to_user_id"/>
        <result property="toUsername" column="to_username"/>
        <result property="content" column="content"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="selectById" resultMap="commentMap">
        SELECT * FROM `comment` WHERE id = #{id}
    </select>

    <select id="selectByPostId" resultMap="commentMap">
        SELECT * FROM `comment` WHERE post_id = #{postId} AND status = 1 ORDER BY created_at ASC
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `comment` (post_id, heritage_id, parent_id, author_id, author_name,
            to_user_id, to_username, content, status, created_at, updated_at)
        VALUES (#{postId}, #{heritageId}, #{parentId}, #{authorId}, #{authorName},
            #{toUserId}, #{toUsername}, #{content}, 1, NOW(), NOW())
    </insert>

    <update id="updateStatus">
        UPDATE `comment` SET status = #{status}, updated_at = NOW() WHERE id = #{id}
    </update>

</mapper>
